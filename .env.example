# Copy to .env and fill in. These stay on the server and are never sent to the browser.

# Anthropic API key (https://console.anthropic.com/) - used for translation.
ANTHROPIC_API_KEY=

# Azure AI Speech resource key + region (Azure portal -> your Speech resource -> Keys and Endpoint).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Optional
PORT=3000
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# Optional: serve HTTPS so phones on your Wi-Fi can use the microphone (see README).
# HTTPS_KEY=certs/key.pem
# HTTPS_CERT=certs/cert.pem
